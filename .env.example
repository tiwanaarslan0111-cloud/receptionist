# PostgreSQL Database Connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/receptionist_db

# Security & Authentication Secrets
ADMIN_SECRET_KEY=admin_master_secret_key_change_me
JWT_SECRET=super_secret_jwt_key_for_client_dashboards_12345

# LLM Provider Configuration ('groq' or 'openai')
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENAI_API_KEY=sk-your_openai_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_MODEL=gpt-4o-mini

# WAHA (WhatsApp HTTP API) Configuration
# In Docker Compose, backend communicates with WAHA over the internal network:
WAHA_BASE_URL=http://waha:3000
# WAHA delivers inbound webhooks directly to backend container:
WAHA_WEBHOOK_URL=http://backend:8000/api/business/whatsapp/webhook
DEFAULT_BUSINESS_ID=1

# WAHA Dashboard Basic Auth
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=admin

# Meta Cloud API (Disabled by default when using WAHA)
ENABLE_META_CLOUD_API=False
WHATSAPP_VERIFY_TOKEN=receptionist_meta_verify_token_123
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id_here
